{
  "name": "scale-ai-com",
  "services": [
    {
      "name": "scale-ai-com",
      "github": {
        "repo": "facingmonday/scale-ai-com",
        "branch": "main",
        "deploy_on_push": true
      },
      "dockerfile_path": "/Dockerfile",
      "source_dir": "/",
      "instance_size_slug": "apps-s-1vcpu-0.5gb",
      "instance_count": 1,
      "http_port": 3000
    }
  ],
  "domains": [
    {
      "domain": "scalelxp.com",
      "type": "PRIMARY"
    }
  ],
  "region": "nyc",
  "alerts": [
    {
      "rule": "DEPLOYMENT_FAILED"
    },
    {
      "rule": "DOMAIN_FAILED"
    }
  ],
  "ingress": {
    "rules": [
      {
        "match": {
          "path": {
            "prefix": "/"
          },
          "authority": {
            "exact": ""
          }
        },
        "component": {
          "name": "scale-ai-com"
        }
      }
    ]
  },
  "features": [
    "buildpack-stack=ubuntu-22"
  ]
}
