{
  "name": "scale-ai-api",
  "version": "1.0.0",
  "description": "",
  "main": "apps/api/index.js",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "start": "node apps/api/index.js",
    "start:api": "node apps/api/index.js",
    "start:webhooks": "node apps/webhooks/index.js",
    "start:workers": "node apps/workers/index.js",
    "dev:api": "nodemon apps/api/index.js",
    "dev:webhooks": "nodemon apps/webhooks/index.js",
    "dev:workers": "nodemon apps/workers/index.js",
    "dev:docs": "npm run docs:generate-spec && vitepress dev apps/docs",
    "dev:web": "npm --prefix apps/web run dev",
    "dev:admin": "npm --prefix apps/admin run dev",
    "dev": "concurrently -k -n api,web,docs -c blue,cyan,yellow \"npm:dev:api\" \"npm:dev:web\" \"npm:dev:docs\"",
    "dev:all": "concurrently -k -n api,webhooks,workers,web,docs,admin -c blue,green,magenta,cyan,yellow,bgMagenta \"npm:dev:api\" \"npm:dev:webhooks\" \"npm:dev:workers\" \"npm:dev:web\" \"npm:dev:docs\" \"npm:dev:admin\"",
    "start:all": "concurrently -k -n api,webhooks,workers,web,admin -c blue,green,magenta,cyan,bgMagenta \"npm:start:api\" \"npm:start:webhooks\" \"npm:start:workers\" \"npm:start:web\" \"npm:start:admin\"",
    "ngrok": "ngrok start --config ~/.ngrok/ngrok.yml --all",
    "email:preview": "npm --prefix apps/admin run start",
    "sync:clerk": "node scripts/sync-clerk.js",
    "sim:cli": "echo '⚠️  The CLI tool has been converted into a web interface! Start the admin server using \"npm run dev:all\" (or \"npm run dev:admin\") and open http://localhost:5174 in your browser.'",
    "install:web": "npm --prefix apps/web ci",
    "install:admin": "npm --prefix apps/admin ci",
    "start:web": "npm --prefix apps/web run preview",
    "build:web": "npm --prefix apps/web run build",
    "build:admin": "npm --prefix apps/admin run build",
    "preview:web": "npm --prefix apps/web run preview",
    "lint:web": "npm --prefix apps/web run lint",
    "test": "node --require ./test/helpers/env.js --test --test-concurrency=1 --test-force-exit 'services/**/*.test.js' 'services/**/*.integration.test.js' 'test/helpers/**/*.test.js'",
    "test:unit": "node --require ./test/helpers/env.js --test --test-concurrency=4 --test-force-exit 'services/**/*.test.js' 'test/helpers/**/*.test.js'",
    "test:integration": "node --require ./test/helpers/env.js --test --test-concurrency=1 --test-force-exit 'services/**/*.integration.test.js'",
    "docs:generate-spec": "node scripts/generate-swagger-json.js",
    "docs:build": "npm run docs:generate-spec && vitepress build apps/docs",
    "docs:preview": "vitepress preview apps/docs",
    "do:validate:dev": "node scripts/deploy-do-app.mjs dev",
    "do:validate:prod": "node scripts/deploy-do-app.mjs prod",
    "do:deploy:dev": "node scripts/deploy-do-app.mjs dev --apply",
    "do:deploy:prod": "node scripts/deploy-do-app.mjs prod --apply"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.515.0",
    "@bull-board/api": "^6.13.0",
    "@bull-board/express": "^6.13.0",
    "@clerk/express": "^1.7.26",
    "@cosmicjs/sdk": "^1.0.11",
    "@google/adk": "^1.1.0",
    "@mendable/firecrawl-js": "^1.16.0",
    "@react-email/components": "^0.5.6",
    "@react-email/render": "^1.3.2",
    "@sendgrid/mail": "^8.1.4",
    "@tiptap/core": "^2.9.1",
    "@tiptap/extension-document": "^2.9.1",
    "@tiptap/extension-image": "^2.23.0",
    "@tiptap/html": "^2.9.1",
    "@tiptap/starter-kit": "^2.9.1",
    "aws-sdk": "^2.1560.0",
    "axios": "^1.6.2",
    "body-parser": "^1.20.2",
    "bull": "^4.16.5",
    "cd": "^0.3.3",
    "cheerio": "^1.0.0-rc.12",
    "cors": "^2.8.5",
    "creatomate": "^1.1.0",
    "dotenv": "^16.4.5",
    "esbuild-register": "^3.6.0",
    "expo-server-sdk": "^3.15.0",
    "express": "^4.18.2",
    "express-oauth2-jwt-bearer": "^1.6.0",
    "express-rate-limit": "^7.5.0",
    "ffmpeg-static": "^5.2.0",
    "firebase-admin": "^12.0.0",
    "fluent-ffmpeg": "^2.1.3",
    "form-data": "^4.0.0",
    "fs": "^0.0.1-security",
    "googleapis": "^134.0.0",
    "handlebars": "^4.7.8",
    "hashids": "^2.3.0",
    "json-fixer": "^1.6.15",
    "json2csv": "^6.0.0-alpha.2",
    "libphonenumber-js": "^1.12.15",
    "lodash": "^4.17.21",
    "luxon": "^3.4.4",
    "markdown-it": "^14.0.0",
    "marked": "^11.0.1",
    "mime": "^2.6.0",
    "moment-timezone": "^0.5.45",
    "mongodb": "^6.10.0",
    "mongoose": "^8.1.1",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "multer-s3": "^2.10.0",
    "music-metadata": "^7.14.0",
    "node-cron": "^3.0.3",
    "openai": "^4.24.7",
    "passkit-generator": "^3.3.1",
    "path": "^0.12.7",
    "prompts": "^2.4.2",
    "qrcode": "^1.5.4",
    "querystring": "^0.2.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "redis": "^5.8.2",
    "serverless-http": "^3.2.0",
    "sharp": "^0.33.5",
    "slugify": "^1.6.6",
    "stripe": "^17.2.1",
    "svix": "^1.67.0",
    "swagger-ui-express": "^5.0.0",
    "telnyx": "^2.1.0",
    "url-file-size": "^1.0.5-1",
    "xml2json": "^0.12.0",
    "yamljs": "^0.3.0",
    "youtube-transcript": "^1.0.6",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.1.0",
    "connect-livereload": "^0.6.1",
    "esbuild": "^0.25.10",
    "kill-port": "^2.0.1",
    "lightningcss-darwin-arm64": "^1.32.0",
    "livereload": "^0.10.3",
    "mongodb-memory-server": "^8.16.1",
    "nodemon": "^3.1.10",
    "supertest": "^7.2.2",
    "swagger-jsdoc": "^6.3.0",
    "vite": "^7.2.4",
    "vitepress": "^1.6.4"
  }
}
